// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  u_id        Int    @id @default(autoincrement())
  email       String @unique
  name        String
  password    String
  role        String @default("member")
  status      String @default("ACTIVE")
  access_time Int    @default(0)
}

model UserWallet {
  wallet_id  Int      @id @default(autoincrement())
  u_id       Int      @unique
  balance    Float
  currency   String   @default("MYR")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([u_id])
}

model StockHolding {
  holding_id Int      @id @default(autoincrement())
  u_id       Int
  symbol     String
  quantity   Int
  avg_price  Float
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([u_id, symbol])
  @@index([u_id])
  @@index([symbol])
}

model StockTransaction {
  transaction_id   Int      @id @default(autoincrement())
  u_id             Int
  symbol           String
  transaction_type String
  quantity         Int
  price            Float
  total_amount     Float
  currency         String   @default("MYR")
  transaction_date DateTime @default(now())
  created_at       DateTime @default(now())

  @@index([u_id])
  @@index([symbol])
  @@index([transaction_date])
}

model StockWatchlist {
  watchlist_id Int      @id @default(autoincrement())
  u_id         Int
  symbol       String
  added_at     DateTime @default(now())

  @@unique([u_id, symbol])
  @@index([u_id])
}

model StockAutoTrader {
  auto_id             Int       @id @default(autoincrement())
  u_id                Int
  symbol              String
  action              String // "BUY" | "SELL"
  trigger_type        String // "PRICE_TARGET" | "MOVING_AVERAGE"
  direction           String // "ABOVE" | "BELOW"
  target_price        Float? // Used when trigger_type = "PRICE_TARGET"
  moving_average_days Int? // Used when trigger_type = "MOVING_AVERAGE"
  quantity            Int
  notify_channels     String    @default("EMAIL,DISCORD")
  is_active           Boolean   @default(true)
  last_checked_price  Float?
  last_trigger_value  Float?
  executed_at         DateTime?
  triggered_at        DateTime?
  last_error          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([u_id])
  @@index([symbol])
  @@index([is_active])
  @@index([created_at])
}

model WalletTransaction {
  transaction_id   Int      @id @default(autoincrement())
  u_id             Int
  transaction_type String // "DEPOSIT", "WITHDRAW", "STOCK_BUY", "STOCK_SELL", "POLYMARKET_BUY", "POLYMARKET_SELL"
  amount           Float
  currency         String   @default("MYR")
  symbol           String? // For stock/polymarket transactions
  quantity         Int? // For stock/polymarket transactions
  price            Float? // For stock/polymarket transactions
  description      String? // Additional details
  balance_after    Float // Balance after transaction
  transaction_date DateTime @default(now())
  created_at       DateTime @default(now())

  @@index([u_id])
  @@index([transaction_type])
  @@index([transaction_date])
}

model PolymarketHolding {
  holding_id Int      @id @default(autoincrement())
  u_id       Int
  market_id  String // Polymarket market ID
  outcome    String // "YES" or "NO"
  quantity   Float // Number of shares
  avg_price  Float // Average price per share in USD
  category   String? // Market category (e.g., "Sports", "Politics", "Crypto")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([u_id, market_id, outcome])
  @@index([u_id])
  @@index([market_id])
}

model PolymarketTransaction {
  transaction_id   Int      @id @default(autoincrement())
  u_id             Int
  market_id        String
  outcome          String // "YES" or "NO"
  transaction_type String // "BUY" or "SELL"
  quantity         Float
  price            Float // Price per share in USD
  total_amount     Float // Total in USD
  currency         String   @default("MYR") // Wallet currency used
  category         String? // Market category (e.g., "Sports", "Politics", "Crypto")
  transaction_date DateTime @default(now())
  created_at       DateTime @default(now())

  @@index([u_id])
  @@index([market_id])
  @@index([transaction_date])
}

model PolymarketWatchlist {
  watchlist_id Int      @id @default(autoincrement())
  u_id         Int
  market_id    String // Polymarket market condition ID
  added_at     DateTime @default(now())

  @@unique([u_id, market_id])
  @@index([u_id])
}

model PolymarketComment {
  comment_id Int      @id @default(autoincrement())
  u_id       Int
  market_id  String
  user_name  String
  content    String
  sentiment  String? // "bullish" | "bearish" | "neutral"
  created_at DateTime @default(now())

  @@index([market_id])
  @@index([u_id])
}

model PolymarketPriceAlert {
  alert_id               Int       @id @default(autoincrement())
  u_id                   Int
  market_id              String
  outcome                String    @default("YES") // "YES" or "NO"
  direction              String // "ABOVE" or "BELOW"
  target_price           Float // Stored in USD probability form (0.00 - 1.00)
  auto_buy_enabled       Boolean   @default(false)
  auto_buy_quantity      Float?
  auto_buy_budget        Float?
  auto_buy_retry_max     Int       @default(0)
  auto_buy_retry_count   Int       @default(0)
  auto_buy_cooldown_m    Int       @default(5)
  auto_buy_next_retry_at DateTime?
  auto_buy_executed_at   DateTime?
  auto_buy_last_error    String?
  tp_target_percent      Float?
  sl_target_percent      Float?
  parent_alert_id        Int?
  alert_tag              String? // "TP" | "SL" | null
  source                 String // "WATCHLIST" or "HOLDING"
  is_active              Boolean   @default(true)
  triggered_at           DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([u_id])
  @@index([market_id])
  @@index([is_active])
  @@index([created_at])
}

model PolymarketMarketGroup {
  group_id        Int                               @id @default(autoincrement())
  name            String
  slug            String                            @unique
  source_url      String?
  source_type     String                            @default("KEYWORD") // "KEYWORD" | "MANUAL"
  match_keywords  String // Comma-separated keywords used to match markets
  is_system       Boolean                           @default(false)
  created_by_u_id Int?
  created_at      DateTime                          @default(now())
  updated_at      DateTime                          @updatedAt
  markets         PolymarketGroupedMarket[]
  snapshots       PolymarketGroupedMarketSnapshot[]

  @@index([is_system])
  @@index([created_by_u_id])
}

model PolymarketGroupedMarket {
  grouped_market_id Int                   @id @default(autoincrement())
  group_id          Int
  market_id         String // Polymarket condition ID used by this app
  clob_token_id     String?
  question          String
  event_title       String?
  event_slug        String?
  category          String?
  is_closed         Boolean               @default(false)
  first_seen_at     DateTime              @default(now())
  last_seen_at      DateTime              @default(now())
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  group             PolymarketMarketGroup @relation(fields: [group_id], references: [group_id], onDelete: Cascade)

  @@unique([group_id, market_id])
  @@index([group_id])
  @@index([market_id])
  @@index([is_closed])
}

model PolymarketGroupedMarketSnapshot {
  snapshot_id  Int                   @id @default(autoincrement())
  group_id     Int
  market_id    String
  collected_at DateTime              @default(now())
  yes_price    Float?
  no_price     Float?
  volume       Float?
  liquidity    Float?
  end_date_iso DateTime?
  is_closed    Boolean               @default(false)
  question     String?
  category     String?
  trade_count  Int                   @default(0) // Number of trades we have stored for this market_id
  group        PolymarketMarketGroup @relation(fields: [group_id], references: [group_id], onDelete: Cascade)

  @@index([group_id])
  @@index([market_id])
  @@index([collected_at])
}

model BacktestHistory {
  id            Int      @id @default(autoincrement())
  market_id     String
  clob_token_id String?
  market_name   String
  group_name    String?
  net_pnl       Float
  return_pct    Float
  trades_count  Int
  start_date    String // YYYY-MM-DD
  end_date      String // YYYY-MM-DD
  initial_cash  Float
  final_equity  Float
  vs_buy_hold   Float // outperformance vs buy-and-hold
  max_drawdown  Float
  executed_at   DateTime @default(now())
  created_at    DateTime @default(now())

  @@index([market_id])
  @@index([executed_at])
  @@index([created_at])
}
